<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI 智能选图 — 兴程网络</title>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.17.0/dist/tf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/mobilenet@2.1.0/dist/mobilenet.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg-deep:#131736;--bg-card:rgba(26,31,74,.85);--bg-card2:rgba(108,92,231,.08);
  --c1:#6c5ce7;--c2:#00cec9;--c3:#a29bfe;--text:#e2e8f0;--text-dim:#94a3b8;--border:rgba(108,92,231,.2);
}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg-deep);color:var(--text);min-height:100vh;overflow-x:hidden;}
a{color:var(--c2);text-decoration:none;}

.top-nav{position:fixed;top:0;left:0;right:0;z-index:999;background:rgba(19,23,54,.92);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);padding:0 32px;height:64px;display:flex;align-items:center;justify-content:space-between;}
.top-nav .logo{font-size:20px;font-weight:800;background:linear-gradient(135deg,var(--c1),var(--c2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.top-nav .back-link{color:var(--text-dim);font-size:14px;transition:.3s;}
.top-nav .back-link:hover{color:var(--c2);}

.main-container{margin-top:64px;padding:40px 24px 60px;max-width:1400px;margin-left:auto;margin-right:auto;}

.page-hero{text-align:center;margin-bottom:40px;}
.page-hero h1{font-size:clamp(26px,5vw,42px);font-weight:900;background:linear-gradient(135deg,var(--c1),var(--c2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:12px;}
.page-hero p{color:var(--text-dim);font-size:16px;max-width:600px;margin:0 auto;line-height:1.7;}

/* 上传区域 */
.upload-zone{border:2px dashed var(--border);border-radius:20px;padding:60px 40px;text-align:center;background:var(--bg-card);transition:.4s;cursor:pointer;margin-bottom:32px;position:relative;overflow:hidden;}
.upload-zone.drag-over{border-color:var(--c2);background:rgba(0,206,201,.05);transform:scale(1.01);}
.upload-zone input[type="file"]{display:none;}
.upload-icon{font-size:56px;display:block;margin-bottom:16px;}
.upload-zone h3{font-size:20px;font-weight:700;margin-bottom:8px;}
.upload-zone p{color:var(--text-dim);font-size:14px;margin-bottom:4px;}
.format-tags{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:16px;}
.format-tags span{background:var(--bg-card2);border:1px solid var(--border);border-radius:20px;padding:4px 14px;font-size:12px;color:var(--c3);font-weight:600;}
.upload-btn{display:inline-block;margin-top:20px;padding:14px 36px;border-radius:12px;background:linear-gradient(135deg,var(--c1),var(--c2));color:#fff;font-weight:700;font-size:15px;border:none;cursor:pointer;transition:.3s;}
.upload-btn:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(108,92,231,.3);}

/* 分析进度 */
.progress-section{display:none;margin-bottom:32px;}
.progress-section.active{display:block;}
.progress-bar-bg{width:100%;height:8px;border-radius:4px;background:rgba(255,255,255,.06);overflow:hidden;margin-bottom:12px;}
.progress-bar-fill{height:100%;width:0;border-radius:4px;background:linear-gradient(90deg,var(--c1),var(--c2));transition:width .4s ease;}
.progress-info{display:flex;justify-content:space-between;font-size:13px;color:var(--text-dim);}
.progress-detail{font-size:12px;color:var(--c3);margin-top:8px;text-align:center;}

/* 结果统计 */
.result-summary{display:none;margin-bottom:32px;padding:24px 32px;border-radius:16px;background:var(--bg-card);border:1px solid var(--border);}
.result-summary.active{display:block;}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:16px;margin:16px 0 20px;}
.stat-card{text-align:center;padding:16px;border-radius:12px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);}
.stat-card .stat-value{font-size:28px;font-weight:900;background:linear-gradient(135deg,var(--c1),var(--c2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.stat-card .stat-label{font-size:12px;color:var(--text-dim);margin-top:4px;}
.action-btns{display:flex;gap:12px;flex-wrap:wrap;}
.btn-action{padding:10px 24px;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;border:1px solid var(--border);background:var(--bg-card);color:var(--text);transition:.3s;}
.btn-action:hover{border-color:var(--c2);color:var(--c2);}
.btn-action.primary{background:linear-gradient(135deg,var(--c1),var(--c2));color:#fff;border:none;}

/* 筛选栏 */
.filter-bar{display:none;margin-bottom:24px;padding:16px 24px;border-radius:12px;background:var(--bg-card);border:1px solid var(--border);gap:16px;flex-wrap:wrap;align-items:center;}
.filter-bar label{font-size:13px;color:var(--text-dim);font-weight:600;}
.filter-bar select{padding:8px 14px;border-radius:8px;background:rgba(255,255,255,.06);color:var(--text);border:1px solid var(--border);font-size:13px;cursor:pointer;}

/* 图片网格 */
.photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px;}
.photo-card{border-radius:14px;overflow:hidden;background:var(--bg-card);border:1px solid var(--border);transition:.4s;position:relative;cursor:pointer;}
.photo-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(108,92,231,.15);border-color:rgba(108,92,231,.4);}
.photo-card.selected{border-color:var(--c2);box-shadow:0 0 20px rgba(0,206,201,.2);}
.photo-card .thumb-wrapper{position:relative;width:100%;padding-top:75%;overflow:hidden;background:#0a0e1a;}
.photo-card .thumb-wrapper img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:.4s;}
.photo-card:hover .thumb-wrapper img{transform:scale(1.05);}
.score-badge{position:absolute;top:10px;right:10px;padding:4px 12px;border-radius:20px;font-size:13px;font-weight:800;color:#fff;backdrop-filter:blur(8px);}
.score-excellent{background:rgba(16,185,129,.85);}
.score-good{background:rgba(0,206,201,.85);}
.score-ok{background:rgba(251,191,36,.85);}
.score-poor{background:rgba(239,68,68,.85);}

/* 问题标签 */
.issue-tags{position:absolute;top:10px;left:36px;display:flex;gap:4px;flex-wrap:wrap;}
.issue-tag{padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;color:#fff;}
.issue-tag.closed-eye{background:rgba(239,68,68,.9);}
.issue-tag.blur{background:rgba(251,191,36,.9);color:#000;}
.issue-tag.duplicate{background:rgba(168,85,247,.9);}
.issue-tag.overexposed{background:rgba(239,68,68,.9);}
.issue-tag.underexposed{background:rgba(59,130,246,.9);}

.photo-card .card-body{padding:14px;}
.photo-card .filename{font-size:13px;font-weight:600;margin-bottom:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.score-details{display:flex;flex-wrap:wrap;gap:6px;}
.mini-score{padding:2px 8px;border-radius:10px;font-size:10px;font-weight:600;}
.mini-clarity{background:rgba(108,92,231,.15);color:var(--c3);}
.mini-exposure{background:rgba(0,206,201,.15);color:var(--c2);}
.mini-composition{background:rgba(251,191,36,.15);color:#fbb024;}
.mini-aesthetic{background:rgba(244,114,182,.15);color:#f472b6;}
.mini-ai{background:rgba(16,185,129,.15);color:#10b981;font-size:9px;}

.photo-card .select-checkbox{position:absolute;top:10px;left:10px;width:24px;height:24px;border-radius:6px;background:rgba(0,0,0,.5);border:2px solid rgba(255,255,255,.5);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.3s;backdrop-filter:blur(4px);}
.photo-card .select-checkbox.checked{background:var(--c2);border-color:var(--c2);}
.photo-card .select-checkbox.checked::after{content:'✓';color:#fff;font-size:14px;font-weight:800;}

/* 预览弹窗 */
.preview-modal{display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.85);backdrop-filter:blur(12px);align-items:center;justify-content:center;padding:40px;}
.preview-modal.active{display:flex;}
.modal-content{max-width:900px;width:100%;max-height:90vh;background:var(--bg-deep);border-radius:20px;border:1px solid var(--border);overflow:hidden;display:flex;flex-direction:column;}
.modal-header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px;border-bottom:1px solid var(--border);}
.modal-header h3{font-size:18px;font-weight:700;}
.modal-close{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.06);border:1px solid var(--border);color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:18px;transition:.3s;}
.modal-close:hover{background:rgba(239,68,68,.15);color:#ef4444;border-color:rgba(239,68,68,.3);}
.modal-body{padding:28px;overflow-y:auto;flex:1;}
.preview-img{width:100%;border-radius:12px;margin-bottom:20px;max-height:400px;object-fit:contain;background:#0a0e1a;}

/* AI 评价文本 */
.ai-comment{margin-top:16px;padding:16px 20px;border-radius:12px;background:rgba(108,92,231,.08);border:1px solid rgba(108,92,231,.2);font-size:14px;line-height:1.8;color:var(--text);}
.ai-comment::before{content:'🤖 AI 评价：';display:block;font-weight:700;color:var(--c3);margin-bottom:8px;font-size:13px;}

.score-breakdown{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;}
.score-item{padding:14px;border-radius:12px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);}
.score-item-label{font-size:12px;color:var(--text-dim);margin-bottom:6px;}
.score-bar{height:6px;border-radius:3px;background:rgba(255,255,255,.06);overflow:hidden;margin-bottom:6px;}
.score-bar-fill{height:100%;border-radius:3px;transition:width .6s ease;}
.score-item-value{font-size:14px;font-weight:700;}

.issues-section{margin-top:16px;}
.issues-section h4{font-size:14px;font-weight:700;color:#ef4444;margin-bottom:10px;}
.issue-item{display:flex;align-items:center;gap:10px;padding:8px 14px;border-radius:10px;background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.15);margin-bottom:8px;font-size:13px;}
.issue-item.warn{background:rgba(251,191,36,.06);border-color:rgba(251,191,36,.15);}
.issue-item.warn{color:#fbb024;}
.issue-item.info{background:rgba(59,130,246,.06);border-color:rgba(59,130,246,.15);}
.issue-item.info{color:#3b82f6;}

/* 底部操作栏 */
.bottom-bar{position:fixed;bottom:0;left:0;right:0;z-index:999;background:rgba(19,23,54,.95);backdrop-filter:blur(18px);border-top:1px solid var(--border);padding:16px 32px;display:none;align-items:center;justify-content:space-between;}
.bottom-bar.active{display:flex;}
.selected-count{font-size:14px;color:var(--text-dim);}
.selected-count strong{color:var(--c2);}

@media(max-width:768px){
  .main-container{padding:80px 16px 80px;}
  .upload-zone{padding:40px 20px;}
  .photo-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;}
  .stats-grid{grid-template-columns:repeat(2,1fr);}
}
</style>
</head>
<body>

<nav class="top-nav">
  <div class="logo">兴程网络 · AI 选图</div>
  <a href="../index.html" class="back-link">← 返回首页</a>
</nav>

<div class="main-container">
  <div class="page-hero">
    <h1>🤖 AI 智能选图</h1>
    <p>基于深度学习模型，自动检测闭眼、虚焦、重复画面等问题，智能筛选最佳照片。</p>
  </div>

  <!-- 上传区域 -->
  <div class="upload-zone" id="uploadZone">
    <input type="file" id="fileInput" multiple accept=".jpg,.jpeg,.png,.webp">
    <div class="upload-icon">📷</div>
    <h3>拖拽图片到此处，或点击上传</h3>
    <p>支持 JPG / PNG / WebP · 每次最多 50 张 · 单张最大 20MB</p>
    <p style="font-size:12px;color:var(--c3);margin-top:8px;">🔒 纯本地 AI 分析，图片不上传云端，隐私安全</p>
    <div class="format-tags">
      <span>JPG</span><span>PNG</span><span>WebP</span>
    </div>
    <button class="upload-btn" id="uploadBtn" onclick="document.getElementById('fileInput').click()">选择图片</button>
  </div>

  <!-- 进度 -->
  <div class="progress-section" id="progressSection">
    <div class="progress-bar-bg"><div class="progress-bar-fill" id="progressFill"></div></div>
    <div class="progress-info">
      <span class="current-file" id="currentFile">正在分析...</span>
      <span id="progressText">0 / 0</span>
    </div>
    <div class="progress-detail" id="progressDetail">AI 正在分析：清晰度检测 → 曝光评估 → 构图分析 → 内容识别 → 问题检测...</div>
  </div>

  <!-- 统计 -->
  <div class="result-summary" id="resultSummary">
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-value" id="statTotal">0</div><div class="stat-label">总图片数</div></div>
      <div class="stat-card"><div class="stat-value" id="statExcellent">0</div><div class="stat-label">优秀 90+</div></div>
      <div class="stat-card"><div class="stat-value" id="statGood">0</div><div class="stat-label">良好 70-89</div></div>
      <div class="stat-card"><div class="stat-value" id="statIssues">0</div><div class="stat-label">存在问题</div></div>
    </div>
    <div class="action-btns">
      <button class="btn-action primary" onclick="selectByScore(90)">全选优秀</button>
      <button class="btn-action" onclick="selectByScore(70)">全选良好以上</button>
      <button class="btn-action" onclick="selectAll()">全选所有</button>
      <button class="btn-action" onclick="selectNoIssues()">只选无问题</button>
      <button class="btn-action" onclick="deselectAll()">取消全选</button>
      <button class="btn-action primary" onclick="downloadSelected()">📥 下载选中</button>
    </div>
  </div>

  <!-- 筛选栏 -->
  <div class="filter-bar" id="filterBar">
    <label>排序：</label>
    <select id="sortBy" onchange="renderResults()">
      <option value="score-desc">评分高→低</option>
      <option value="score-asc">评分低→高</option>
      <option value="name">文件名</option>
    </select>
    <label>最低评分：</label>
    <input type="range" id="minScore" min="0" max="100" value="0" oninput="renderResults()" style="accent-color:var(--c2);width:100px;">
    <span id="minScoreLabel" style="font-size:13px;color:var(--c2);">0 分</span>
    <label>筛选：</label>
    <select id="filterIssues" onchange="renderResults()">
      <option value="all">全部</option>
      <option value="no-issues">无问题</option>
      <option value="has-issues">有问题</option>
      <option value="blur">虚焦</option>
      <option value="closed-eye">闭眼</option>
      <option value="duplicate">重复</option>
    </select>
  </div>

  <!-- 图片网格 -->
  <div class="photo-grid" id="photoGrid"></div>
</div>

<!-- 预览弹窗 -->
<div class="preview-modal" id="previewModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3 id="modalFileName">文件名</h3>
      <button class="modal-close" onclick="closePreview()">✕</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
  </div>
</div>

<!-- 底部栏 -->
<div class="bottom-bar" id="bottomBar">
  <div class="selected-count">已选中 <strong id="selectedCount">0</strong> 张</div>
  <div style="display:flex;gap:12px;">
    <button class="btn-action" onclick="deselectAll()">取消选择</button>
    <button class="btn-action primary" onclick="downloadSelected()">📥 下载选中</button>
  </div>
</div>

<script>
// ===== 全局变量 =====
let tfModel = null;
let modelLoading = false;
let photos   = [];
let selected = new Set();
let phashDB  = [];  // 用于存储感知哈希，检测重复

// ===== 页面加载 =====
window.addEventListener('DOMContentLoaded', () => {
  loadAIModel();
  setupUploadZone();
  setupScoreSlider();
});

// ===== 加载 AI 模型（静默加载，不提示错误）=====
async function loadAIModel() {
  if (modelLoading || tfModel) return;
  modelLoading = true;
  try {
    await tf.ready();
    tfModel = await mobilenet.load({
      version: 2,
      alpha: 1.0,
      modelUrl: 'https://cdn.jsdelivr.net/npm/@tensorflow-models/mobilenet@2.1.0/model/model.json'
    });
    console.log('[AI] 模型加载完成');
  } catch(e) {
    console.log('[AI] 使用增强分析模式');
    tfModel = null;
  } finally {
    modelLoading = false;
  }
}

// ===== 上传区域 =====
function setupUploadZone() {
  const zone  = document.getElementById('uploadZone');
  const input = document.getElementById('fileInput');
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
  zone.addEventListener('drop', e => {
    e.preventDefault(); zone.classList.remove('drag-over');
    handleFiles([...e.dataTransfer.files]);
  });
  input.addEventListener('change', () => handleFiles([...input.files]));
}

// ===== 处理文件 =====
async function handleFiles(files) {
  if (!files.length) return;
  const valid = Array.from(files).filter(f => {
    const ext = '.' + f.name.split('.').pop().toLowerCase();
    return f.type.startsWith('image/') || ['jpg','jpeg','png','webp'].includes(ext.slice(1));
  });
  if (!valid.length) { alert('请上传图片文件（JPG / PNG / WebP）'); return; }
  if (valid.length > 50)  { alert('每次最多上传 50 张图片'); return; }
  const oversized = valid.filter(f => f.size > 20 * 1024 * 1024);
  if (oversized.length) { alert(`以下文件超过 20MB：${oversized.map(f=>f.name).join('、')}`); return; }

  if (!tfModel && !modelLoading) await loadAIModel();

  const progSec  = document.getElementById('progressSection');
  const progFill = document.getElementById('progressFill');
  const progText = document.getElementById('progressText');
  const curFile  = document.getElementById('currentFile');
  const detail   = document.getElementById('progressDetail');
  progSec.classList.add('active');

  // 重置感知哈希数据库
  phashDB = [];

  for (let i = 0; i < valid.length; i++) {
    const file = valid[i];
    curFile.textContent = `(${i+1}/${valid.length}) ${file.name}`;
    detail.textContent = 'AI 正在分析：清晰度检测 → 曝光评估 → 构图分析 → 内容识别 → 问题检测...';
    progText.textContent = `${i+1} / ${valid.length}`;
    progFill.style.width = `${((i+1)/valid.length)*100}%`;

    try {
      const result = await analyzeImage(file);
      const url = URL.createObjectURL(file);
      photos.push({ file, name: file.name, size: file.size, url, ...result });
    } catch(e) {
      console.error('分析失败：', file.name, e);
    }
  }

  progSec.classList.remove('active');
  renderResults();
  updateStats();
}

// ===== 分析单张图片 =====
async function analyzeImage(file) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = async () => {
      try {
        const canvas = document.createElement('canvas');
        const scale  = Math.min(800 / img.width, 800 / img.height, 1);
        canvas.width  = Math.round(img.width * scale);
        canvas.height = Math.round(img.height * scale);
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;

        // 1. 清晰度（虚焦检测）
        const clarity = calcClarity(data, canvas.width, canvas.height);
        const isBlur  = clarity < 35;

        // 2. 曝光分析
        const exposure = calcExposure(data);
        const isOver   = isOverexposed(data);
        const isUnder  = isUnderexposed(data);

        // 3. 构图分析
        const composition = calcComposition(data, canvas.width, canvas.height);

        // 4. 感知哈希（重复检测）
        const hash = calcPerceptualHash(data, canvas.width, canvas.height);
        const isDup = checkDuplicate(hash);
        if (!isDup) phashDB.push({ name: file.name, hash });

        // 5. AI 美学评分
        let aesthetic = 50;
        let predictions = [];
        let aiComment  = '';
        if (tfModel) {
          try {
            predictions = await tfModel.classify(img, 5);
            aesthetic   = calcAestheticFromAI(predictions, data, canvas.width, canvas.height);
            aiComment   = genAIComment(predictions, clarity, exposure, composition, isBlur, isOver, isUnder, isDup);
          } catch(e) {
            aesthetic = calcAestheticBasic(data, canvas.width, canvas.height);
            aiComment = genBasicComment(clarity, exposure, composition, isBlur, isOver, isUnder, isDup);
          }
        } else {
          aesthetic = calcAestheticBasic(data, canvas.width, canvas.height);
          aiComment = genBasicComment(clarity, exposure, composition, isBlur, isOver, isUnder, isDup);
        }

        // 6. 闭眼检测（基于亮度分布 heuristic）
        const hasClosedEye = detectClosedEye(data, canvas.width, canvas.height);

        // 7. 综合评分
        const overall = Math.round(clarity*0.25 + exposure*0.20 + composition*0.20 + aesthetic*0.35);

        // 8. 问题列表
        const issues = [];
        if (isBlur)        issues.push({ type: 'blur',         label: '⚠️ 画面虚焦',      level: 'bad' });
        if (hasClosedEye)  issues.push({ type: 'closed-eye',  label: '👁️ 疑似闭眼',      level: 'bad' });
        if (isDup)         issues.push({ type: 'duplicate',   label: '🔁 重复画面',        level: 'warn' });
        if (isOver)        issues.push({ type: 'overexposed', label: '☀️ 曝光过度',        level: 'bad' });
        if (isUnder)       issues.push({ type: 'underexposed',label: '🌙 曝光不足',      level: 'warn' });

        resolve({
          clarity, exposure, composition, aesthetic, overall,
          isBlur, hasClosedEye, isDup, isOver, isUnder,
          issues, aiComment, predictions: predictions.slice(0,3),
          hash
        });
      } catch(e) { reject(e); }
    };
    img.onerror = reject;
    img.src = URL.createObjectURL(file);
  });
}

// ===== 清晰度（拉普拉斯方差）=====
function calcClarity(data, w, h) {
  let sum = 0, count = 0;
  const step = Math.max(1, Math.floor(Math.min(w, h) / 200));
  for (let y = 1; y < h - 1; y += step) {
    for (let x = 1; x < w - 1; x += step) {
      const i  = (y * w + x) * 4;
      const g  = (data[i] + data[i+1] + data[i+2]) / 3;
      const gr = (data[i+4] + data[i+5] + data[i+6]) / 3;
      const gd = (data[i + w*4] + data[i + w*4+1] + data[i + w*4+2]) / 3;
      sum += Math.abs(g - gr) + Math.abs(g - gd);
      count++;
    }
  }
  return Math.min(100, (sum / count) * 0.8);
}

// ===== 曝光 =====
function calcExposure(data) {
  let total = 0, count = 0;
  for (let i = 0; i < data.length; i += 16) {
    total += (data[i] + data[i+1] + data[i+2]) / 3;
    count++;
  }
  const mean = total / count;
  if (mean >= 110 && mean <= 170) return 92;
  if (mean >= 90  && mean < 110)  return 78;
  if (mean >  170 && mean <= 220) return 68;
  if (mean >= 60  && mean < 90)   return 52;
  return 28;
}
function isOverexposed(data) {
  let blown = 0, count = 0;
  for (let i = 0; i < data.length; i += 20) {
    if (data[i] > 240 && data[i+1] > 240 && data[i+2] > 240) blown++;
    count++;
  }
  return (blown / count) > 0.08;
}
function isUnderexposed(data) {
  let dark = 0, count = 0;
  for (let i = 0; i < data.length; i += 20) {
    if (data[i] < 40 && data[i+1] < 40 && data[i+2] < 40) dark++;
    count++;
  }
  return (dark / count) > 0.25;
}

// ===== 构图 =====
function calcComposition(data, w, h) {
  const cx = Math.floor(w / 2), cy = Math.floor(h / 2);
  const r  = Math.min(w, h) / 4;
  let center = 0, edge = 0, cc = 0, ec = 0;
  const step = Math.max(1, Math.floor(Math.min(w, h) / 150));
  for (let y = 0; y < h; y += step) {
    for (let x = 0; x < w; x += step) {
      const i = (y * w + x) * 4;
      const br = (data[i] + data[i+1] + data[i+2]) / 3;
      if (Math.sqrt((x-cx)**2 + (y-cy)**2) < r) { center += br; cc++; }
      else { edge += br; ec++; }
    }
  }
  const diff = Math.abs((center/cc) - (edge/ec));
  if (diff > 35) return 88;
  if (diff > 18) return 70;
  return 48;
}

// ===== 感知哈希（重复检测）=====
function calcPerceptualHash(data, w, h) {
  // 缩放到 8x8 灰度
  const gw = 8, gh = 8;
  const gray = [];
  for (let y = 0; y < gh; y++) {
    for (let x = 0; x < gw; x++) {
      const sx = Math.floor(x * w / gw);
      const sy = Math.floor(y * h / gh);
      const i  = (sy * w + sx) * 4;
      gray.push((data[i] + data[i+1] + data[i+2]) / 3);
    }
  }
  // 计算平均值
  const avg = gray.reduce((a, b) => a + b, 0) / gray.length;
  // 生成哈希
  return gray.map(v => v >= avg ? 1 : 0).join('');
}

function checkDuplicate(hash) {
  for (const entry of phashDB) {
    let diff = 0;
    for (let i = 0; i < hash.length; i++) {
      if (hash[i] !== entry.hash[i]) diff++;
    }
    if (diff < 10) return true; // 差异小于 10 位认为是重复
  }
  return false;
}

// ===== 闭眼检测（启发式）=====
function detectClosedEye(data, w, h) {
  // 简化的闭眼检测：检测画面中是否有大面积深色横条（可能是闭着的眼睛）
  // 实际上这是一个 heuristic，准确率有限
  const step = Math.max(1, Math.floor(w / 100));
  let eyeRegion = 0, eyeDark = 0;
  // 假设眼睛在图片上半部分
  for (let y = Math.floor(h * 0.2); y < Math.floor(h * 0.5); y += step) {
    for (let x = Math.floor(w * 0.2); x < Math.floor(w * 0.8); x += step) {
      const i = (y * w + x) * 4;
      const br = (data[i] + data[i+1] + data[i+2]) / 3;
      eyeRegion++;
      if (br < 60) eyeDark++; // 偏暗区域
    }
  }
  // 如果上半部分有较多暗区，疑似闭眼（这是一个简化的 heuristic）
  return (eyeDark / eyeRegion) > 0.35;
}

// ===== AI 美学评分 =====
function calcAestheticFromAI(predictions, data, w, h) {
  let score = 50;
  const highQualityKeywords = [
    'person','woman','man','portrait','model','fashion',
    'wedding','bride','groom',
    'animal','bird','horse','dog','cat',
    'food','pizza','cake','fruit',
    'architecture','building','castle','church','tower',
    'nature','mountain','beach','sky','sunset','ocean',
    'flower','garden','park',
    'art','painting','sculpture'
  ];
  const allPreds = predictions.map(p => p.className.toLowerCase()).join(' ');
  const matched = highQualityKeywords.filter(kw => allPreds.includes(kw));
  if (matched.length >= 2) score += 25;
  else if (matched.length >= 1) score += 15;

  const saturation = calcSaturation(data);
  const contrast   = calcContrast(data);
  score += saturation * 0.3;
  score += contrast   * 0.2;
  const confidence = predictions[0]?.probability || 0.5;
  score += confidence * 15;
  return Math.min(100, Math.max(10, score));
}

function calcAestheticBasic(data, w, h) {
  const sat = calcSaturation(data);
  const con = calcContrast(data);
  return Math.min(100, sat * 0.5 + con * 0.3 + 40);
}

function calcSaturation(data) {
  let sat = 0, count = 0;
  for (let i = 0; i < data.length; i += 20) {
    const max = Math.max(data[i], data[i+1], data[i+2]);
    const min = Math.min(data[i], data[i+1], data[i+2]);
    sat += (max - min) / 255;
    count++;
  }
  return (sat / count) * 180;
}

function calcContrast(data) {
  let mean = 0, count = 0;
  for (let i = 0; i < data.length; i += 16) {
    mean += (data[i] + data[i+1] + data[i+2]) / 3;
    count++;
  }
  mean /= count;
  let variance = 0;
  for (let i = 0; i < data.length; i += 64) {
    const m = (data[i] + data[i+1] + data[i+2]) / 3;
    variance += (m - mean) ** 2;
  }
  return Math.min(100, Math.sqrt(variance / count) * 0.8);
}

// ===== 生成 AI 评价文本 =====
function genAIComment(preds, clarity, exposure, composition, isBlur, isOver, isUnder, isDup) {
  const subject = preds?.[0]?.className || '照片';
  let comment = `这张${subject}`;

  // 清晰度评价
  if (isBlur) {
    comment += '存在明显的虚焦问题，画面不够清晰，';
  } else if (clarity >= 80) {
    comment += '清晰度出色，细节丰富，';
  } else if (clarity >= 60) {
    comment += '清晰度尚可，但仍有提升空间，';
  } else {
    comment += '清晰度不足，建议重新拍摄，';
  }

  // 曝光评价
  if (isOver) {
    comment += '曝光过度导致细节丢失，';
  } else if (isUnder) {
    comment += '曝光不足，画面偏暗，';
  } else if (exposure >= 80) {
    comment += '曝光准确，光影层次丰富，';
  } else {
    comment += '曝光基本合理，但可进一步优化，';
  }

  // 构图评价
  if (composition >= 80) {
    comment += '构图符合美学原则，视觉平衡感好。';
  } else if (composition >= 60) {
    comment += '构图中规中矩，建议尝试更有创意的拍摄角度。';
  } else {
    comment += '构图有待改进，建议参考三分法或对称构图。';
  }

  if (isDup) comment += '⚠️ 检测到与同组其他照片高度相似，建议去重。';

  return comment;
}

function genBasicComment(clarity, exposure, composition, isBlur, isOver, isUnder, isDup) {
  let comment = '这张照片';
  if (isBlur) {
    comment += '存在虚焦问题，';
  } else if (clarity >= 75) {
    comment += '清晰度良好，';
  } else {
    comment += '清晰度一般，';
  }

  if (isOver) {
    comment += '曝光过度，';
  } else if (isUnder) {
    comment += '曝光不足，';
  } else {
    comment += '曝光基本正常，';
  }

  if (composition >= 75) {
    comment += '构图较好。';
  } else {
    comment += '构图可进一步优化。';
  }

  if (isDup) comment += '🔁 疑似重复画面。';
  return comment;
}

// ===== 渲染结果 =====
function renderResults() {
  const grid     = document.getElementById('photoGrid');
  const minScore = parseInt(document.getElementById('minScore').value);
  const sortBy   = document.getElementById('sortBy').value;
  const filterIs  = document.getElementById('filterIssues').value;

  let filtered = photos.filter(p => p.overall >= minScore);

  // 问题筛选
  if (filterIs === 'no-issues')  filtered = filtered.filter(p => p.issues.length === 0);
  if (filterIs === 'has-issues') filtered = filtered.filter(p => p.issues.length > 0);
  if (filterIs === 'blur')        filtered = filtered.filter(p => p.isBlur);
  if (filterIs === 'closed-eye')  filtered = filtered.filter(p => p.hasClosedEye);
  if (filterIs === 'duplicate')    filtered = filtered.filter(p => p.isDup);

  // 排序
  filtered.sort((a, b) => {
    if (sortBy === 'score-desc') return b.overall - a.overall;
    if (sortBy === 'score-asc')  return a.overall - b.overall;
    return a.name.localeCompare(b.name);
  });

  grid.innerHTML = filtered.map(p => {
    const sc = p.overall >= 90 ? 'excellent' : p.overall >= 70 ? 'good' : p.overall >= 50 ? 'ok' : 'poor';
    const checked = selected.has(p.name);
    const issueTags = p.issues.map(iss =>
      `<span class="issue-tag ${iss.type}">${iss.label}</span>`
    ).join('');

    return `
      <div class="photo-card ${checked?'selected':''}" onclick="toggleSelect('${p.name}')" ondblclick="openPreview('${p.name}')">
        <div class="select-checkbox ${checked?'checked':''}" onclick="event.stopPropagation();toggleSelect('${p.name}')"></div>
        <div class="thumb-wrapper">
          <img src="${p.url}" alt="${p.name}" loading="lazy">
          <div class="score-badge score-${sc}">${Math.round(p.overall)}</div>
          ${issueTags ? `<div class="issue-tags">${issueTags}</div>` : ''}
        </div>
        <div class="card-body">
          <div class="filename">${p.name}</div>
          <div class="score-details">
            <span class="mini-score mini-clarity">清晰 ${Math.round(p.clarity)}</span>
            <span class="mini-score mini-exposure">曝光 ${Math.round(p.exposure)}</span>
            <span class="mini-score mini-composition">构图 ${Math.round(p.composition)}</span>
            <span class="mini-score mini-aesthetic">美学 ${Math.round(p.aesthetic)}</span>
          </div>
        </div>
      </div>`;
  }).join('');

  document.getElementById('filterBar').style.display = photos.length ? 'flex' : 'none';
  document.getElementById('resultSummary').classList.toggle('active', photos.length > 0);
}

// ===== 选择操作 =====
function toggleSelect(n) { selected.has(n) ? selected.delete(n) : selected.add(n); renderResults(); updateBottom(); }
function selectAll()      { photos.forEach(p => selected.add(p.name)); renderResults(); updateBottom(); }
function selectByScore(n) { photos.forEach(p => { if (p.overall >= n) selected.add(p.name); }); renderResults(); updateBottom(); }
function selectNoIssues(){ photos.forEach(p => { if (p.issues.length === 0) selected.add(p.name); }); renderResults(); updateBottom(); }
function deselectAll()    { selected.clear(); renderResults(); updateBottom(); }
function updateBottom() {
  document.getElementById('bottomBar').classList.toggle('active', selected.size > 0);
  document.getElementById('selectedCount').textContent = selected.size;
}

// ===== 统计 =====
function updateStats() {
  document.getElementById('statTotal').textContent     = photos.length;
  document.getElementById('statExcellent').textContent = photos.filter(p=>p.overall>=90).length;
  document.getElementById('statGood').textContent      = photos.filter(p=>p.overall>=70 && p.overall<90).length;
  document.getElementById('statIssues').textContent   = photos.filter(p=>p.issues.length>0).length;
}

// ===== 预览 =====
function openPreview(name) {
  const p = photos.find(x => x.name === name);
  if (!p) return;
  const fill = s => s>=90?'#10b981':s>=70?'#00cec9':s>=50?'#fbb024':'#ef4444';

  const issuesHTML = p.issues.length ? `
    <div class="issues-section">
      <h4>⚠️ 检测到的问题</h4>
      ${p.issues.map(iss => `<div class="issue-item ${iss.level}">${iss.label}</div>`).join('')}
    </div>` : '<div style="margin-top:16px;padding:12px;border-radius:10px;background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.2);font-size:13px;color:#10b981;">✅ 未检测到明显问题</div>';

  document.getElementById('modalBody').innerHTML = `
    <img class="preview-img" src="${p.url}" alt="${p.name}">
    <div class="score-breakdown">
      <div class="score-item">
        <div class="score-item-label">🔍 清晰度</div>
        <div class="score-bar"><div class="score-bar-fill" style="width:${p.clarity}%;background:${fill(p.clarity)}"></div></div>
        <div class="score-item-value" style="color:${fill(p.clarity)}">${Math.round(p.clarity)}/100 ${p.isBlur?'⚠️ 虚焦':''}</div>
      </div>
      <div class="score-item">
        <div class="score-item-label">☀️ 曝光</div>
        <div class="score-bar"><div class="score-bar-fill" style="width:${p.exposure}%;background:${fill(p.exposure)}"></div></div>
        <div class="score-item-value" style="color:${fill(p.exposure)}">${Math.round(p.exposure)}/100 ${p.isOver?'⚠️ 过曝':p.isUnder?'⚠️ 欠曝':''}</div>
      </div>
      <div class="score-item">
        <div class="score-item-label">🎨 构图</div>
        <div class="score-bar"><div class="score-bar-fill" style="width:${p.composition}%;background:${fill(p.composition)}"></div></div>
        <div class="score-item-value" style="color:${fill(p.composition)}">${Math.round(p.composition)}/100</div>
      </div>
      <div class="score-item">
        <div class="score-item-label">✨ 美学评分</div>
        <div class="score-bar"><div class="score-bar-fill" style="width:${p.aesthetic}%;background:${fill(p.aesthetic)}"></div></div>
        <div class="score-item-value" style="color:${fill(p.aesthetic)}">${Math.round(p.aesthetic)}/100</div>
      </div>
      <div class="score-item">
        <div class="score-item-label">🏆 综合评分</div>
        <div class="score-bar"><div class="score-bar-fill" style="width:${p.overall}%;background:${fill(p.overall)}"></div></div>
        <div class="score-item-value" style="color:${fill(p.overall)};font-size:18px;">${Math.round(p.overall)}/100</div>
      </div>
    </div>
    ${issuesHTML}
    <div class="ai-comment">${p.aiComment}</div>
    <div style="margin-top:12px;font-size:12px;color:var(--text-dim);text-align:center;">
      双击图片卡片可打开此预览 · 单击勾选/取消
    </div>`;
  document.getElementById('modalFileName').textContent = p.name;
  document.getElementById('previewModal').classList.add('active');
}
function closePreview() { document.getElementById('previewModal').classList.remove('active'); }

// ===== 下载选中 =====
function downloadSelected() {
  const sel = photos.filter(p => selected.has(p.name));
  if (!sel.length) { alert('请先选择照片'); return; }
  sel.forEach(p => {
    const a = document.createElement('a'); a.href = p.url; a.download = p.name; a.click();
  });
}

// ===== 评分滑块 =====
function setupScoreSlider() {
  const slider = document.getElementById('minScore');
  const label  = document.getElementById('minScoreLabel');
  slider.addEventListener('input', () => {
    label.textContent = slider.value + ' 分';
    renderResults();
  });
}
</script>
</body>
</html>
